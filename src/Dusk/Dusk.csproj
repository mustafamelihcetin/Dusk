<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\dusk.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Dusk</AssemblyName>
    <Product>Dusk</Product>
    <Description>A calm, safe shutdown timer for Windows</Description>
    <Version>1.1.0</Version>
    <!-- ThemeMode (Fluent) is still flagged experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep WinForms/GDI names out of the global namespace; WPF owns the UI. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\dusk.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dusk.Core\Dusk.Core.csproj" />
  </ItemGroup>

</Project>
