<Window x:Class="Dusk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Dusk.Controls"
        Title="Dusk"
        Icon="pack://application:,,,/Assets/dusk.ico"
        Width="420" SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">

    <Grid Margin="28,20,28,24">
        <StackPanel>

            <!-- What should happen -->
            <Border CornerRadius="9" Padding="3"
                    Background="{DynamicResource ControlAltFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid x:Name="ActionBar" AutomationProperties.Name="Ne yapılsın" />
            </Border>

            <!-- Dial -->
            <Grid Width="300" Height="300" Margin="0,22,0,6" HorizontalAlignment="Center">
                <c:Dial x:Name="Dial"
                        Accent="{DynamicResource AccentFillColorDefaultBrush}"
                        Track="{DynamicResource ControlFillColorSecondaryBrush}"
                        Tick="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                        AutomationProperties.Name="Süre"
                        AutomationProperties.HelpText="Halkayı sürükleyin ya da ok tuşları ve fare tekerleğiyle ayarlayın" />
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock x:Name="BigText" FontSize="44" FontWeight="Light" TextAlignment="Center"
                               Typography.NumeralAlignment="Tabular"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="SubText" FontSize="13.5" TextAlignment="Center" Margin="0,2,0,0"
                               TextWrapping="Wrap" MaxWidth="190"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="HintText" FontSize="11" TextAlignment="Center" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Grid>

            <!-- Quick picks -->
            <StackPanel x:Name="Presets" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                <Button Style="{StaticResource ChipStyle}" Content="15 dk" Tag="15" Click="Preset_Click" />
                <Button Style="{StaticResource ChipStyle}" Content="30 dk" Tag="30" Click="Preset_Click" />
                <Button Style="{StaticResource ChipStyle}" Content="1 sa" Tag="60" Click="Preset_Click" />
                <Button Style="{StaticResource ChipStyle}" Content="2 sa" Tag="120" Click="Preset_Click" />
            </StackPanel>

            <!-- Main action -->
            <Grid Margin="0,22,0,0" Height="44">
                <Button x:Name="StartButton" Style="{DynamicResource AccentButtonStyle}"
                        HorizontalAlignment="Stretch" FontSize="15" Click="Start_Click" IsDefault="True" />
                <Grid x:Name="RunningButtons" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="+10 dk" FontSize="15" HorizontalAlignment="Stretch"
                            Click="Extend_Click" ToolTip="Süreyi 10 dakika uzat" />
                    <Button Grid.Column="2" Content="İptal" FontSize="15" HorizontalAlignment="Stretch"
                            Click="Cancel_Click" IsCancel="True" />
                </Grid>
            </Grid>

            <!-- Safety option -->
            <CheckBox x:Name="ForceBox" Margin="2,16,0,0" FontSize="13"
                      Content="Kaydedilmemiş işleri bekleme"
                      ToolTip="Açık uygulamalar kaydetmeyi sormadan kapatılır. Kapalıyken Windows, kaydedilmemiş iş varsa sizi bekler." />

            <TextBlock x:Name="Notice" Margin="2,12,0,0" FontSize="12.5" TextWrapping="Wrap"
                       Visibility="Collapsed" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Grid>
</Window>
