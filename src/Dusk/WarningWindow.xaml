<Window x:Class="Dusk.WarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Dusk.Controls"
        Title="Dusk"
        Icon="pack://application:,,,/Assets/dusk.ico"
        Width="400" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True" ShowInTaskbar="True" ShowActivated="False"
        UseLayoutRounding="True">
    <StackPanel Margin="28,22,28,24">
        <Grid Width="120" Height="120" HorizontalAlignment="Center">
            <c:Dial x:Name="Ring" IsRunning="True" Focusable="False" IsHitTestVisible="False"
                    Accent="{DynamicResource SystemFillColorCautionBrush}"
                    Track="{DynamicResource ControlFillColorSecondaryBrush}"
                    Tick="Transparent" />
            <TextBlock x:Name="Seconds" FontSize="34" FontWeight="Light"
                       Typography.NumeralAlignment="Tabular"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        </Grid>

        <TextBlock x:Name="Headline" Margin="0,16,0,0" FontSize="18" FontWeight="SemiBold"
                   TextAlignment="Center" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <TextBlock x:Name="Detail" Margin="0,6,0,0" FontSize="13" TextAlignment="Center" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <Grid Margin="0,22,0,0" Height="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="8" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Button x:Name="SnoozeButton" Grid.Column="0" Content="10 dk ertele" HorizontalAlignment="Stretch"
                    Style="{DynamicResource AccentButtonStyle}" IsDefault="True" Click="Snooze_Click" />
            <Button Grid.Column="2" Content="İptal et" HorizontalAlignment="Stretch" IsCancel="True" Click="Cancel_Click" />
        </Grid>
        <Button x:Name="NowButton" Margin="0,8,0,0" Height="34" HorizontalAlignment="Stretch"
                Background="Transparent" BorderThickness="0"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}" Click="Now_Click" />
    </StackPanel>
</Window>
